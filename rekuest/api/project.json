{
    "schema": "http://jhnnsrs-lab/rekuest/schema",
    "documents": "graphql/**/**.graphql",
    "extensions": {
        "turms": {
            "domain": null,
            "out_dir": "rekuest/api",
            "dump_configuration": true,
            "configuration_name": "project.json",
            "dump_schema": true,
            "schema_name": "schema.graphql",
            "generated_name": "schema.py",
            "documents": "graphql/**/**.graphql",
            "verbose": false,
            "exit_on_error": true,
            "allow_introspection": true,
            "object_bases": [
                "pydantic.BaseModel"
            ],
            "interface_bases": null,
            "always_resolve_interfaces": true,
            "exclude_typenames": true,
            "scalar_definitions": {
                "uuid": "str",
                "Callback": "str",
                "Any": "typing.Any",
                "AnyInput": "typing.Any",
                "JSONSerializable": "rekuest.scalars.JSONSerializable",
                "UISchema": "rekuest.scalars.UISchema",
                "AnyDefault": "typing.Any",
                "Args": "rekuest.scalars.Args",
                "ValueMap": "rekuest.scalars.ValueMap",
                "MediaLike": "rekuest.scalars.MediaLike",
                "ID": "rath.scalars.ID",
                "ActionHash": "rekuest.scalars.ActionHash",
                "Arg": "typing.Any",
                "Identifier": "rekuest.scalars.Identifier",
                "SearchQuery": "rekuest.scalars.SearchQuery"
            },
            "coercible_scalars": {},
            "coercible_inputs": {},
            "graphql_default_class": null,
            "deprecated_class": null,
            "document_field_metadata": true,
            "unset_type_class": null,
            "unset_instance": null,
            "freeze": {
                "enabled": true,
                "types": [
                    "input",
                    "fragment",
                    "object"
                ],
                "exclude": null,
                "include": null,
                "convert_list_to_tuple": true
            },
            "create_catchall": true,
            "options": {
                "enabled": true,
                "extra": "forbid",
                "populate_by_name": true,
                "from_attributes": null,
                "use_enum_values": true,
                "validate_assignment": null,
                "alias_mode": "split",
                "types": [
                    "input"
                ],
                "exclude": null,
                "include": null
            },
            "skip_forwards": false,
            "min_python_version": "3.10",
            "type_annotation_style": "auto",
            "additional_bases": {
                "Action": [
                    "rekuest.traits.action.Callable"
                ],
                "AnnotationInput": [
                    "rekuest.traits.ports.AnnotationInputTrait"
                ],
                "ArgPortInput": [
                    "rekuest.traits.ports.PortTrait"
                ],
                "ReturnPortInput": [
                    "rekuest.traits.ports.PortTrait"
                ],
                "SearchAssignWidgetInput": [
                    "rekuest.traits.ports.SearchWidgetInputTrait"
                ],
                "SliderAssignWidgetInput": [
                    "rekuest.traits.ports.SliderWidgetInputTrait"
                ],
                "StateChoiceAssignWidgetInput": [
                    "rekuest.traits.ports.StateChoiceWidgetInputTrait"
                ],
                "CreateBlokInput": [
                    "rekuest.traits.blok.CreateBlokInputTrait"
                ],
                "ImplementationInput": [
                    "rekuest.traits.implementation.ImplementationInputTrait"
                ],
                "BlokImplementationInput": [
                    "rekuest.traits.blok.BlokImplementationInputTrait"
                ],
                "ImplementAgentInput": [
                    "rekuest.traits.agent.ImplementAgentInputTrait"
                ],
                "ValidatorInput": [
                    "rekuest.traits.ports.ValidatorInputTrait"
                ],
                "EffectInput": [
                    "rekuest.traits.ports.EffectInputTrait"
                ],
                "DefinitionInput": [
                    "rekuest.traits.ports.DefinitionInputTrait"
                ]
            },
            "additional_config": {},
            "force_plugin_order": true,
            "omitted_document_rules": [],
            "parsers": [],
            "plugins": [
                {
                    "type": "turms.plugins.enums.EnumsPlugin"
                },
                {
                    "type": "turms.plugins.inputs.InputsPlugin"
                },
                {
                    "type": "turms.plugins.fragments.FragmentsPlugin"
                },
                {
                    "type": "turms.plugins.operations.OperationsPlugin"
                },
                {
                    "type": "turms.plugins.funcs.FuncsPlugin",
                    "coercible_scalars": {
                        "SearchQuery": "rekuest.scalars.SearchQueryCoercible",
                        "ID": "rath.scalars.IDCoercible"
                    },
                    "expand_input_types": [
                        "input"
                    ],
                    "global_kwargs": [
                        {
                            "type": "rekuest.rath.RekuestNextRath",
                            "key": "rath",
                            "description": "The arkitekt rath client"
                        }
                    ],
                    "definitions": [
                        {
                            "type": "subscription",
                            "is_async": true,
                            "use": "rekuest.funcs.asubscribe"
                        },
                        {
                            "type": "query",
                            "is_async": true,
                            "use": "rekuest.funcs.aexecute"
                        },
                        {
                            "type": "mutation",
                            "is_async": true,
                            "use": "rekuest.funcs.aexecute"
                        },
                        {
                            "type": "subscription",
                            "use": "rekuest.funcs.subscribe"
                        },
                        {
                            "type": "query",
                            "use": "rekuest.funcs.execute"
                        },
                        {
                            "type": "mutation",
                            "use": "rekuest.funcs.execute"
                        }
                    ]
                }
            ],
            "processors": [
                {
                    "type": "turms.processors.disclaimer.DisclaimerProcessor"
                }
            ],
            "stylers": [
                {
                    "type": "turms.stylers.default.DefaultStyler"
                },
                {
                    "type": "turms.stylers.appender.AppenderStyler",
                    "append_fragment": ""
                }
            ]
        }
    }
}